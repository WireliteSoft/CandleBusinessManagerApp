{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --open",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:api": "node --test server/tests/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "seed:mock-storefront": "node server/scripts/seedMockStorefrontCustomers.js",
    "cf:types": "wrangler types --config wrangler.jsonc",
    "cf:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "cf:dev": "wrangler dev --config wrangler.jsonc",
    "cf:deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "cf:d1:migrate:local": "wrangler d1 migrations apply candles-business-staging --local --config wrangler.local.jsonc",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply candles-business-staging --remote --config wrangler.jsonc",
    "cf:d1:export": "node scripts/export-sqlite-to-d1.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.344.0",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "square": "^45.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wrangler": "^4.128.0"
  }
}
